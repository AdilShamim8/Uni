{
  "name": "@uni/contracts",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Uni shared API contracts: DTOs, runtime schemas (zod), and stream event types. The only coupling point between frontend and backend.",
  "license": "MIT",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "clean": "rm -rf dist",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "prepare": "npm run build",
  "dependencies": {
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "typescript": "^7.0.2"
  }
}

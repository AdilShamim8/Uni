# Frontend environment example — copy to frontend/.env (gitignored).
# VITE_* values are PUBLIC: they are embedded in the browser bundle and
# must never contain secrets.

# Base URL of the Uni backend API (public URL only).
# Empty or omitted = same origin: the Vite dev server proxies /api and
# /health to the local backend; production serves frontend + API behind
# one reverse proxy origin.
VITE_API_BASE_URL=

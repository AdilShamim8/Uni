{
  "name": "uni-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Uni backend — TypeScript modular monolith (Fastify + PostgreSQL + Drizzle).",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit -p tsconfig.typecheck.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/db/migrate.ts",
    "qa:live": "npm run build && node scripts/qa-live.mjs",
    "worker": "tsx src/worker.ts",
    "worker:build": "npm run build && node dist/worker.js"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^4.0.88",
    "@ai-sdk/openai-compatible": "3.0.84",
    "@fastify/cors": "^11.4.0",
    "@fastify/static": "^10.1.8",
    "@modelcontextprotocol/sdk": "1.32.2",
    "@uni/contracts": "file:../packages/contracts",
    "ai": "^7.0.166",
    "better-auth": "^1.7.13",
    "dotenv": "^18.0.10",
    "drizzle-orm": "^0.45.4",
    "fastify": "^5.12.7",
    "pg": "^8.23.1",
    "pg-boss": "10.4.2",
    "pino": "^10.4.0",
    "undici": "^8.12.4",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/pg": "^8.23.1",
    "drizzle-kit": "^0.31.11",
    "embedded-postgres": "^18.4.0-beta.17",
    "tsx": "^4.23.15",
    "typescript": "^5.6.3",
    "vitest": "^5.0.5"
  },
  "allowScripts": {
    "@embedded-postgres/linux-x64@18.4.0-beta.17": true,
    "esbuild@0.18.20": true,
    "esbuild@0.25.12": true,
    "esbuild@0.28.2": true
  }
}

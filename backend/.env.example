# Uni backend — local development environment example.
# Copy to backend/.env (ignored by git) and change every default before
# any hosted or shared use. NEVER commit real secrets.

NODE_ENV=development
PORT=4000
HOST=127.0.0.1
LOG_LEVEL=info

# Matches infra/docker-compose.yml development defaults.
DATABASE_URL=postgres://uni:uni_dev_change_me@127.0.0.1:5432/uni

# Allowed browser origins for credentialed requests (comma separated).
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Public base URL of this API deployment (auth cookies + trusted origins).
APP_URL=http://127.0.0.1:4000

# Registration policy: open (default) or closed. Hosted deployments
# without configured email verification should set closed.
AUTH_REGISTRATION=open

# Session signing secret (read by Better Auth). Optional in development,
# REQUIRED in production — the server refuses to start with the default
# secret when NODE_ENV=production. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
BETTER_AUTH_SECRET=

# Credential encryption: base64-encoded 32-byte master key. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# MUST come from deployment secrets; never commit real values. Back it up
# separately from the database — restoring a DB without this key cannot
# recover provider credentials.
CREDENTIAL_MASTER_KEY=
CREDENTIAL_KEY_ID=key-1

# Operator setting for self-hosted local models (loopback/private ranges
# and custom ports). Never enable for multi-user hosted deployments.
ALLOW_LOCAL_MODEL_ENDPOINTS=false
LOCAL_MODEL_ENDPOINT_ALLOWLIST=
